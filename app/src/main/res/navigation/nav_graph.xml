<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/todoListFragment">

    <fragment
        android:id="@+id/todoListFragment"
        android:name="com.getgifted.todoapp.ui.fragments.TodoListFragment"
        android:label="Todo List"
        tools:layout="@layout/fragment_todo_list">
        <action
            android:id="@+id/action_todoList_to_todoDetail"
            app:destination="@id/todoDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/todoDetailFragment"
        android:name="com.getgifted.todoapp.ui.fragments.TodoDetailFragment"
        android:label="Todo Details"
        tools:layout="@layout/fragment_todo_detail">
        <argument
            android:name="todoId"
            app:argType="integer" />
    </fragment>

</navigation>
